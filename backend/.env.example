# LLM provider configuration (Phase 3, Revision 2).
# Copy this file to `.env` in the same directory and fill in real values.
# `.env` is git-ignored and must never be committed or shared.
#
# The LLM layer is provider-agnostic: it speaks the OpenAI-compatible
# chat-completions protocol, so switching provider means changing these values
# only. Extraction fails with a clear configuration error when LLM_API_KEY or
# LLM_MODEL is missing, so no other endpoint depends on them being present.

# --- Required ---
# Placeholders only: never put a real key in this committed file. Copy it to
# `.env` (git-ignored) and fill in the real values there.
LLM_API_KEY = your-openai-compatible-api-key
LLM_MODEL = your-model-name

# --- Optional (defaults shown) ---
# Provider base URL; the client posts to <base>/chat/completions.
LLM_BASE_URL=https://api.deepseek.com/v1
# Per-request timeout in seconds.
LLM_TIMEOUT_SECONDS=60
# Safety cap on invoice text characters sent in a single request; longer
# documents are truncated and an extraction warning is recorded.
LLM_MAX_INPUT_CHARACTERS=60000
# Transport-level retries.
LLM_MAX_RETRIES=2
# Structured-output strategy: json_mode (default), json_schema, function_calling
# or plain. Unsupported strategies fall back to prompt-based JSON parsing.
LLM_STRUCTURED_METHOD=json_mode
# Label recorded in reports and responses (for example deepseek, ollama-local).
LLM_PROVIDER_LABEL=openai-compatible

# --- Provider examples (copy the pair that matches your provider) ---
# DeepSeek:   LLM_BASE_URL=https://api.deepseek.com/v1      LLM_MODEL=deepseek-flash
# DeepSeek:   (also supports LLM_MODEL=deepseek-v4-pro; the API lists supported names)
# OpenAI:     LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
# Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.1-70b-versatile
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=deepseek/deepseek-chat
# Ollama:     LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=llama3.1

# --- VAT rules engine (Phase 4) ---
# AED tolerance for monetary comparisons.
VAT_AUDIT_MONETARY_TOLERANCE=0.01
# Findings below this confidence (0-100) must be reviewed by a human.
VAT_AUDIT_HUMAN_REVIEW_CONFIDENCE_THRESHOLD=80
# Version identifier recorded with every audit run.
VAT_AUDIT_RULESET_VERSION=uae-vat-rules-1.0.0
# ROUND_HALF_UP (default), ROUND_HALF_EVEN, ROUND_DOWN or ROUND_UP.
VAT_AUDIT_ROUNDING_POLICY=ROUND_HALF_UP
# Whether the configured scenario requires each TRN on the invoice.
VAT_AUDIT_REQUIRES_SUPPLIER_TRN=true
VAT_AUDIT_REQUIRES_CUSTOMER_TRN=false
# Comma-separated rule IDs switched off for this deployment (empty = all enabled).
VAT_AUDIT_DISABLED_RULES=
# Maximum model/re-extraction passes per audit run (1-5); keeps the agent loop bounded.
VAT_AUDIT_MAX_AGENT_ITERATIONS=2

# --- OCR fallback (Phase 9) ---
# Runs only on pages whose pdfplumber text layer is unusable (scanned/image-only).
# The PaddleOCR dependency is optional: install it with `pip install -r requirements-ocr.txt`.
# Without it, a scanned upload is stored with extraction_status="needs_ocr".
VAT_AUDIT_OCR_ENABLED=true
# PaddleOCR language code (en = Latin script).
VAT_AUDIT_OCR_LANGUAGE=en
# Device PaddleOCR runs on: cpu (default, no GPU required), gpu:0, npu, ...
# A laptop without a GPU simply leaves this at cpu.
VAT_AUDIT_OCR_DEVICE=cpu
# PaddleOCR's oneDNN (MKL-DNN) acceleration. Off by default: PaddlePaddle 3.x raises
# NotImplementedError inside oneDNN on some CPU builds, which fails every page. Set to
# true only if this machine's PaddlePaddle build handles it (it is faster when it works).
VAT_AUDIT_OCR_ENABLE_MKLDNN=false
# Threads for PaddleOCR's CPU kernels (4 suits a laptop; PaddleOCR's own default of 10
# oversubscribes it).
VAT_AUDIT_OCR_CPU_THREADS=4
# OCR models. The mobile pair is ~4x faster per scanned page on a CPU than the PP-OCRv6
# medium models PaddleOCR would otherwise download. Set both to empty to use PaddleOCR's
# own choice (more accurate, much slower without a GPU). The recogniser is
# language-specific: change it together with VAT_AUDIT_OCR_LANGUAGE.
VAT_AUDIT_OCR_DET_MODEL=PP-OCRv5_mobile_det
VAT_AUDIT_OCR_REC_MODEL=en_PP-OCRv5_mobile_rec
# Resolution used to render a scanned page for OCR. 150 reads a printed invoice as well as
# 200 and takes about half the time on a CPU; raise it for small print.
VAT_AUDIT_OCR_DPI=150
# A page whose collapsed text is shorter than this is treated as having no usable text
# layer and becomes an OCR candidate.
VAT_AUDIT_OCR_MIN_PAGE_CHARACTERS=12
# Upper bound on how many pages one upload may OCR.
VAT_AUDIT_OCR_MAX_PAGES=25

